      "component": "DataTable",
      "anchor": "full-width"
    },
    {
      "zone_id": "zone_button",
      "component": "PrimaryButton",
      "anchor": "center"
    },
    {
      "zone_id": "zone_modal",
      "component": "Modal",
      "anchor": "center",
      "z_layer": "overlay"
    }
  ],
  "components": [],
  "entities": [
    {
      "name": "patients",
      "fields": [
        "id",
        "full_name",
        "age",
        "height_cm",
        "weight_kg",
        "bmi"
      ],
      "computed": [],
      "display_fields": [],
      "filters": []
    }
  ],
  "actions": [
    {
      "action_id": "load_patient_detail",
      "trigger": "row_select",
      "operation": "load_patient_detail",
      "payload": {},
      "validation_rules": [],
