    },
    {
      "action_id": "calculate_bmi",
      "trigger": "button_click",
      "operation": "calculate_bmi",
      "payload": {},
      "validation_rules": [],
      "requires_confirmation": false
    },
    {
      "action_id": "save_note",
      "trigger": "form_submit",
      "operation": "save_note",
      "payload": {},
      "validation_rules": [],
      "requires_confirmation": false
    }
  ],
  "feedback": [
