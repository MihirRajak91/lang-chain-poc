# Required
OPENAI_API_KEY=your_openai_api_key_here

# Agent models
CONVERSATIONALIST_MODEL=gpt-4o
CONVERSATIONALIST_TEMPERATURE=0.7
CONVERSATIONALIST_MAX_TOKENS=1024

EXTRACTOR_MODEL=gpt-4o-mini
EXTRACTOR_TEMPERATURE=0.0
EXTRACTOR_MAX_TOKENS=512

INTERVIEWER_MODEL=gpt-4o
INTERVIEWER_TEMPERATURE=0.6
INTERVIEWER_MAX_TOKENS=512
INTERVIEWER_PARAPHRASE_ENABLED=false

SUMMARISER_MODEL=gpt-4o
SUMMARISER_TEMPERATURE=0.3
SUMMARISER_MAX_TOKENS=1024

EMITTER_MODEL=gpt-4o
EMITTER_TEMPERATURE=0.0
EMITTER_MAX_TOKENS=4096

# App behavior
FREE_CHAT_TURN_THRESHOLD=6

# Feature flags
DESIGN_INTEL_ENABLED=true
REACT_QUALITY_AUDIT_ENABLED=true
QUALITY_GATE_MODE=hybrid
KNOWLEDGE_PACK_VERSION=v1-curated

# Logging
LOG_LEVEL=INFO
