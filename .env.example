# LLM provider routing
LLM_PRIMARY_PROVIDER=bedrock
LLM_FALLBACK_PROVIDER=openai

# OpenAI (optional when primary is bedrock; used for fallback)
OPENAI_API_KEY=

# AWS / Bedrock (preferred: SDK default chain via profile/role/env)
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Agent models
CONVERSATIONALIST_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0
CONVERSATIONALIST_TEMPERATURE=0.7
CONVERSATIONALIST_MAX_TOKENS=1024

EXTRACTOR_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0
EXTRACTOR_TEMPERATURE=0.0
EXTRACTOR_MAX_TOKENS=512

INTERVIEWER_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0
INTERVIEWER_TEMPERATURE=0.6
INTERVIEWER_MAX_TOKENS=512
INTERVIEWER_PARAPHRASE_ENABLED=false

SUMMARISER_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0
SUMMARISER_TEMPERATURE=0.3
SUMMARISER_MAX_TOKENS=1024

EMITTER_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0
EMITTER_TEMPERATURE=0.0
EMITTER_MAX_TOKENS=4096

# App behavior
FREE_CHAT_TURN_THRESHOLD=6

# Feature flags
DESIGN_INTEL_ENABLED=true
REACT_QUALITY_AUDIT_ENABLED=true
QUALITY_GATE_MODE=hybrid
KNOWLEDGE_PACK_VERSION=v1-curated

# Logging
LOG_LEVEL=INFO
